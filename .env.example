# Settings the backend reads from environment variables.
# Copy this file to .env and fill in real values. Never commit the real .env file.
# If a variable is not set, the backend falls back to the local development default shown in application.yml.

# --- Database ---
# Local dev (Docker): jdbc:postgresql://localhost:5432/healthwatch
# Deployed (Supabase, use the "Session pooler" connection details):
#   jdbc:postgresql://<pooler-host>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/healthwatch
DB_USERNAME=healthwatch
DB_PASSWORD=change-me

# --- Server ---
# Port the app listens on. Most cloud hosts set this automatically.
PORT=8080

# --- Login tokens (JWT) ---
# Use a long random string (at least 32 characters) in any deployed environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# --- Frontend access (CORS) ---
# Web addresses allowed to call the API, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000
